TEST_DATABASE_URL=postgresql://fintech_user:fintech_pass@localhost:5432/fintech_test_db

ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
