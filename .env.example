# Application
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://fintech_user:fintech_pass@localhost:5432/fintech_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fintech_db
DB_USER=fintech_user
DB_PASSWORD=fintech_pass

# Test DB (isolated schema)
TEST_DATABASE_URL=postgresql://fintech_user:fintech_pass@localhost:5432/fintech_test_db

# Pact Broker (optional — can run without)
PACT_BROKER_URL=http://localhost:9292
PACT_BROKER_TOKEN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Encryption (PCI-DSS: card data at rest)
ENCRYPTION_KEY=32-char-hex-key-change-in-production
